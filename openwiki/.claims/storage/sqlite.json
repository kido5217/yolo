    {
      "id": "claim_250e5f0499d948fa93f33c12daea2bf4",
      "statement": "Open(path) opens/creates the database and runs pending migrations, setting PRAGMAs per connection via DSN keys (file:<path>?_foreign_keys=1&_busy_timeout=5000&_journal_mode=WAL) since busy_timeout and foreign_keys are not persisted, and pins the pool to one shared connection (SetMaxOpenConns(1), SetMaxIdleConns(1)) so a single-writer store cannot bypass them.",
      "evidence": [
        {
          "resource": "repo://internal/storage/db.go#L31-L52",
